FROM ubuntu:24.04

# Install bash, curl (needed for run_http subtest).
RUN apt-get update && apt-get install -y --no-install-recommends bash curl && \
    rm -rf /var/lib/apt/lists/*

# Inject the pre-compiled, statically-linked Pebble binary.
# The build context contains a file named "pebble" placed there by the Go test
# framework before invoking podman build.
COPY pebble /usr/local/bin/pebble
RUN chmod +x /usr/local/bin/pebble

# Copy the test script.
COPY test.sh /test.sh
RUN chmod +x /test.sh

ENTRYPOINT ["/test.sh"]
